{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "frontend/packages/*",
    "shared/industry",
    "legacy/ts-compat/api",
    "legacy/ts-compat/backend",
    "tooling"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env.development tooling/scripts/migrate.ts",
    "sources:retire-unsubscribed": "node tooling/scripts/retire-unsubscribed-sources.ts",
    "dev:web": "npm run dev -w @aihot/web",
    "dev:local": "node --env-file=.env.development tooling/scripts/dev-local.mjs",
    "typecheck": "tsc -p frontend/packages/contracts && tsc -p frontend/packages/og-renderer && tsc -p frontend/packages/site && tsc -p legacy/ts-compat/backend && tsc -p legacy/ts-compat/api && tsc -p legacy/ts-compat/tests && tsc -p tooling/tests && tsc -p shared/modules && tsc -p shared/industry && npm run typecheck -w @aihot/web",
    "test": "node --test-global-setup=legacy/ts-compat/tests/databases.ts --import ./legacy/ts-compat/tests/databases.ts --test --test-concurrency=6 --test-timeout=120000 \"legacy/ts-compat/tests/*.test.ts\" \"tooling/tests/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
