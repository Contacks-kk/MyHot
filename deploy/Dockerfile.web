# React Router SSR runtime. Go API and Worker are deployed as separate services.
FROM node:24-trixie-slim AS base
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

FROM base AS build
ARG NPM_REGISTRY=
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/
COPY frontend/packages/og-renderer/package.json frontend/packages/og-renderer/
COPY shared/contracts/package.json shared/contracts/
COPY shared/industry/package.json shared/industry/
COPY shared/site/package.json shared/site/
COPY legacy/ts-compat/api/package.json legacy/ts-compat/api/
COPY legacy/ts-compat/backend/package.json legacy/ts-compat/backend/
COPY tooling/package.json tooling/
RUN npm ci --workspace=@aihot/web --include-workspace-root=false --no-audit --no-fund ${NPM_REGISTRY:+--registry=$NPM_REGISTRY}
COPY . .
RUN npm run build -w @aihot/web && npm prune --omit=dev --workspace=@aihot/web --include-workspace-root=false --no-audit --no-fund

FROM base
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/node_modules /app/node_modules
COPY --from=build --chown=node:node /app/frontend /app/frontend
COPY --from=build --chown=node:node /app/shared/contracts /app/shared/contracts
COPY --from=build --chown=node:node /app/shared/industry /app/shared/industry
COPY --from=build --chown=node:node /app/shared/site /app/shared/site
COPY --from=build --chown=node:node /app/shared/modules /app/shared/modules
RUN mkdir -p /data/ogcache && chown -R node:node /data
USER node
EXPOSE 3000
CMD ["node", "frontend/server.ts"]
