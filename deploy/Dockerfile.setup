# One-shot Node image for SQL migration tooling. Web and Go have separate runtime images.
FROM node:24-trixie-slim AS base
WORKDIR /app
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

FROM base AS build
ARG NPM_REGISTRY=
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/
COPY frontend/packages/og-renderer/package.json frontend/packages/og-renderer/
COPY frontend/packages/contracts/package.json frontend/packages/contracts/
COPY frontend/packages/site/package.json frontend/packages/site/
COPY tooling/package.json tooling/
RUN npm ci --omit=dev --workspace=@aihot/tooling --include-workspace-root=false --no-audit --no-fund ${NPM_REGISTRY:+--registry=$NPM_REGISTRY}
COPY . .

FROM base
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/node_modules /app/node_modules
COPY --from=build --chown=node:node /app/tooling /app/tooling
COPY --from=build --chown=node:node /app/frontend/packages/contracts /app/frontend/packages/contracts
COPY --from=build --chown=node:node /app/frontend/packages/site /app/frontend/packages/site
COPY --from=build --chown=node:node /app/backend-go/config/model-catalog.json /app/backend-go/config/model-catalog.json
COPY --from=build --chown=node:node /app/backend-go/modules /app/backend-go/modules
COPY --from=build --chown=node:node /app/database /app/database
RUN mkdir -p /data && chown -R node:node /data
USER node
CMD ["node", "tooling/scripts/migrate.ts"]
